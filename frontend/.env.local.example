# 복사해서 frontend/.env.local 로 사용 (커밋 금지 — .gitignore에 .env*.local 포함).

# 백엔드 API 주소 (로컬 기본값)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (Auth 전용). https://supabase.com 무료 프로젝트 생성 후 값 입력.
# 미설정이면 개발 스캐폴딩 모드(인증 없이 화면 열람 가능).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 웹푸시 VAPID 공개키 (T-F6). backend/.env의 VAPID_PUBLIC_KEY와 같은 키 쌍이어야 한다.
# 키 생성: cd backend && python -c "from pywebpush import webpush" 대신 아래 한 줄로 생성한다
#   npx web-push generate-vapid-keys
# 공개키는 여기에, 개인키는 backend/.env의 VAPID_PRIVATE_KEY에. 미설정이면 "알림 켜기" 버튼이
# no-vapid-key 상태로 조용히 비활성 동작한다(수신 설정 저장까지는 됨).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
