# 복사해서 frontend/.env.local 로 사용 (커밋 금지 — .gitignore에 .env*.local 포함).

# 백엔드 API 주소 (로컬 기본값). ★ 데이터 라우터 prefix(/api/v1)까지 포함해야 한다.
# 백엔드를 다른 포트로 띄웠으면 포트만 바꾼다 (예: http://localhost:8010/api/v1).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Supabase (Auth 전용). https://supabase.com 무료 프로젝트 생성 후 값 입력.
# 미설정이면 개발 스캐폴딩 모드(인증 없이 화면 열람 가능).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase 미설정 개발모드에서 API 호출에 쓰는 로컬 JWT (이게 없으면 모든 데이터 API 가 401).
# backend/.env 의 SUPABASE_JWT_SECRET 으로 서명(HS256, aud=authenticated), sub = 데모 시드의 DEV_USER_ID.
# 발급 (backend 폴더, 가상환경에서):
#   python -c "import jwt,datetime as d; from app.config import settings; print(jwt.encode({'sub':'00000000-0000-4000-8000-000000000001','aud':'authenticated','exp':d.datetime.now(d.UTC)+d.timedelta(days=180)}, settings.supabase_jwt_secret, algorithm='HS256'))"
NEXT_PUBLIC_DEV_TOKEN=

# 웹푸시 VAPID 공개키 (T-F6). backend/.env의 VAPID_PUBLIC_KEY와 같은 키 쌍이어야 한다.
# 키 생성: cd backend && python -c "from pywebpush import webpush" 대신 아래 한 줄로 생성한다
#   npx web-push generate-vapid-keys
# 공개키는 여기에, 개인키는 backend/.env의 VAPID_PRIVATE_KEY에. 미설정이면 "알림 켜기" 버튼이
# no-vapid-key 상태로 조용히 비활성 동작한다(수신 설정 저장까지는 됨).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
